{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "CMake: configure VSCode index",
      "type": "shell",
      "command": "D:/stm32cubeclt/STM32CubeCLT_1.18.0/CMake/bin/cmake.exe",
      "args": [
        "-S", "${workspaceFolder}",
        "-B", "${workspaceFolder}/cmake-build-vscode",
        "-G", "Ninja",
        "-DCMAKE_C_COMPILER=D:/stm32cubeclt/STM32CubeCLT_1.18.0/GNU-tools-for-STM32/bin/arm-none-eabi-gcc.exe",
        "-DCMAKE_ASM_COMPILER=D:/stm32cubeclt/STM32CubeCLT_1.18.0/GNU-tools-for-STM32/bin/arm-none-eabi-gcc.exe",
        "-DCMAKE_MAKE_PROGRAM=D:/stm32cubeclt/STM32CubeCLT_1.18.0/Ninja/bin/ninja.exe",
        "-DCMAKE_EXPORT_COMPILE_COMMANDS=ON"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
  ]
